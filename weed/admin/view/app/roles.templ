package app

import (
    "fmt"
    "github.com/seaweedfs/seaweedfs/weed/admin/dash"
)

templ Roles(data dash.RolesData) {
    <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
        <h1 class="h2">
            <i class="fas fa-user-shield me-2"></i>IAM Roles
        </h1>
        <div class="btn-toolbar mb-2 mb-md-0">
            <div class="btn-group me-2">
                <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#createRoleModal">
                    <i class="fas fa-plus me-1"></i>Create Role
                </button>
            </div>
        </div>
    </div>

    <div id="roles-content">
        <!-- Summary Cards -->
        <div class="row mb-4">
            <div class="col-xl-4 col-md-6 mb-4">
                <div class="card border-left-primary shadow h-100 py-2">
                    <div class="card-body">
                        <div class="row no-gutters align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                    Total Roles
                                </div>
                                <div class="h5 mb-0 font-weight-bold text-gray-800">
                                    { fmt.Sprintf("%d", data.TotalRoles) }
                                </div>
                            </div>
                            <div class="col-auto">
                                <i class="fas fa-user-shield fa-2x text-gray-300"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-4 col-md-6 mb-4">
                <div class="card border-left-success shadow h-100 py-2">
                    <div class="card-body">
                        <div class="row no-gutters align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                    Last Updated
                                </div>
                                <div class="h5 mb-0 font-weight-bold text-gray-800">
                                    { data.LastUpdated.Format("2006-01-02 15:04:05") }
                                </div>
                            </div>
                            <div class="col-auto">
                                <i class="fas fa-clock fa-2x text-gray-300"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-4 col-md-6 mb-4">
                <div class="card border-left-info shadow h-100 py-2">
                    <div class="card-body">
                        <div class="row no-gutters align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                                    User
                                </div>
                                <div class="h5 mb-0 font-weight-bold text-gray-800">
                                    { data.Username }
                                </div>
                            </div>
                            <div class="col-auto">
                                <i class="fas fa-user fa-2x text-gray-300"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Roles Table -->
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">
                    <i class="fas fa-list me-2"></i>Roles List
                </h6>
            </div>
            <div class="card-body">
                if len(data.Roles) == 0 {
                    <div class="text-center py-4">
                        <i class="fas fa-user-shield fa-3x text-gray-300 mb-3"></i>
                        <h5 class="text-gray-500">No roles found</h5>
                        <p class="text-gray-400">Create your first IAM role to get started.</p>
                        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createRoleModal">
                            <i class="fas fa-plus me-1"></i>Create First Role
                        </button>
                    </div>
                } else {
                    <div class="table-responsive">
                        <table class="table table-bordered" id="rolesTable" width="100%" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Role Name</th>
                                    <th>Role ARN</th>
                                    <th>Attached Policies</th>
                                    <th>Description</th>
                                    <th>Created</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                for _, role := range data.Roles {
                                    <tr>
                                        <td>
                                            <strong>{role.Name}</strong>
                                            <br>
                                            <small class="text-muted">IAM Role</small>
                                        </td>
                                        <td>
                                            <code class="small">{role.RoleArn}</code>
                                        </td>
                                        <td>
                                            if len(role.AttachedPolicies) == 0 {
                                                <span class="badge bg-secondary">No policies</span>
                                            } else {
                                                for _, policy := range role.AttachedPolicies {
                                                    <span class="badge bg-info me-1">{policy}</span>
                                                }
                                            }
                                        </td>
                                        <td>
                                            if role.Description == "" {
                                                <span class="text-muted">-</span>
                                            } else {
                                                {role.Description}
                                            }
                                        </td>
                                        <td>
                                            <small>{role.CreatedAt.Format("2006-01-02 15:04")}</small>
                                        </td>
                                        <td>
                                            <div class="btn-group btn-group-sm" role="group">
                                                <button type="button" class="btn btn-outline-primary" data-roleName={role.Name} onclick="viewRole(event)">
                                                    <i class="fas fa-eye"></i>
                                                </button>
                                                <button type="button" class="btn btn-outline-warning" data-roleName={role.Name} onclick="editRole(event)">
                                                    <i class="fas fa-edit"></i>
                                                </button>
                                                <button type="button" class="btn btn-outline-danger" data-roleName={role.Name} onclick="deleteRole(event)">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Create Role Modal -->
    <div class="modal fade" id="createRoleModal" tabindex="-1" role="dialog" aria-labelledby="createRoleModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="createRoleModalLabel">
                        <i class="fas fa-plus me-2"></i>Create New IAM Role
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="createRoleForm">
                        <div class="mb-3">
                            <label for="roleName" class="form-label">Role Name *</label>
                            <input type="text" class="form-control" id="roleName" name="name" required>
                            <div class="form-text">Unique identifier for the role (e.g., "S3ReadOnlyRole")</div>
                        </div>
                        <div class="mb-3">
                            <label for="roleArn" class="form-label">Role ARN</label>
                            <input type="text" class="form-control" id="roleArn" name="role_arn">
                            <div class="form-text">Optional: Custom ARN (auto-generated if not provided)</div>
                        </div>
                        <div class="mb-3">
                            <label for="roleDescription" class="form-label">Description</label>
                            <textarea class="form-control" id="roleDescription" name="description" rows="2"></textarea>
                        </div>
                        <div class="mb-3">
                            <label for="trustPolicy" class="form-label">Trust Policy *</label>
                            <textarea class="form-control" id="trustPolicy" name="trust_policy" rows="8" required placeholder='{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "Service": "ec2.amazonaws.com"
      },
      "Action": ["sts:AssumeRole"]
    }
  ]
}'></textarea>
                            <div class="form-text d-flex align-items-center">
                                JSON policy document defining who can assume this role
                                <div class="dropdown ms-2">
                                    <button class="btn btn-sm btn-outline-info dropdown-toggle" type="button" id="templateDropdown" data-bs-toggle="dropdown">
                                        <i class="fas fa-file-code me-1"></i>Use Template
                                    </button>
                                    <ul class="dropdown-menu">
                                        <li><h6 class="dropdown-header">Common Trust Policies</h6></li>
                                        <li><a class="dropdown-item" href="#" onclick="setTrustPolicyTemplate('ec2')">
                                            <i class="fas fa-server me-2"></i>EC2 Service
                                        </a></li>
                                        <li><a class="dropdown-item" href="#" onclick="setTrustPolicyTemplate('lambda')">
                                            <i class="fas fa-bolt me-2"></i>Lambda Function
                                        </a></li>
                                        <li><a class="dropdown-item" href="#" onclick="setTrustPolicyTemplate('s3')">
                                            <i class="fas fa-cube me-2"></i>S3 Service
                                        </a></li>
                                        <li><a class="dropdown-item" href="#" onclick="setTrustPolicyTemplate('ecs')">
                                            <i class="fas fa-docker me-2"></i>ECS Task
                                        </a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item" href="#" onclick="setTrustPolicyTemplate('cross-account')">
                                            <i class="fas fa-exchange-alt me-2"></i>Cross Account
                                        </a></li>
                                        <li><a class="dropdown-item" href="#" onclick="setTrustPolicyTemplate('web-identity')">
                                            <i class="fas fa-globe me-2"></i>Web Identity
                                        </a></li>
                                    </ul>
                                </div>
                                <button type="button" class="btn btn-sm btn-outline-secondary ms-2" onclick="validateTrustPolicy()">
                                    <i class="fas fa-check me-1"></i>Validate
                                </button>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="attachedPolicies" class="form-label">Attached Policies</label>
                            <input type="text" class="form-control" id="attachedPolicies" name="attached_policies">
                            <div class="form-text">Comma-separated list of policy names to attach</div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" onclick="createRole()">
                        <i class="fas fa-plus me-1"></i>Create Role
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- View Role Modal -->
    <div class="modal fade" id="viewRoleModal" tabindex="-1" role="dialog" aria-labelledby="viewRoleModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="viewRoleModalLabel">
                        <i class="fas fa-eye me-2"></i>Role Details
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="viewRoleContent">
                    <!-- Content will be populated by JavaScript -->
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn btn-warning" onclick="editRoleFromView()">
                        <i class="fas fa-edit me-1"></i>Edit Role
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Edit Role Modal -->
    <div class="modal fade" id="editRoleModal" tabindex="-1" role="dialog" aria-labelledby="editRoleModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="editRoleModalLabel">
                        <i class="fas fa-edit me-2"></i>Edit IAM Role
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="editRoleForm">
                        <input type="hidden" id="editRoleName" name="name">
                        <div class="mb-3">
                            <label for="editRoleArn" class="form-label">Role ARN</label>
                            <input type="text" class="form-control" id="editRoleArn" name="role_arn" readonly>
                            <div class="form-text">Role ARN cannot be modified</div>
                        </div>
                        <div class="mb-3">
                            <label for="editRoleDescription" class="form-label">Description</label>
                            <textarea class="form-control" id="editRoleDescription" name="description" rows="2"></textarea>
                        </div>
                        <div class="mb-3">
                            <label for="editTrustPolicy" class="form-label">Trust Policy *</label>
                            <textarea class="form-control" id="editTrustPolicy" name="trust_policy" rows="8" required></textarea>
                            <div class="form-text d-flex align-items-center">
                                JSON policy document defining who can assume this role
                                <div class="dropdown ms-2">
                                    <button class="btn btn-sm btn-outline-info dropdown-toggle" type="button" id="editTemplateDropdown" data-bs-toggle="dropdown">
                                        <i class="fas fa-file-code me-1"></i>Use Template
                                    </button>
                                    <ul class="dropdown-menu">
                                        <li><h6 class="dropdown-header">Common Trust Policies</h6></li>
                                        <li><a class="dropdown-item" href="#" onclick="setEditTrustPolicyTemplate('ec2')">
                                            <i class="fas fa-server me-2"></i>EC2 Service
                                        </a></li>
                                        <li><a class="dropdown-item" href="#" onclick="setEditTrustPolicyTemplate('lambda')">
                                            <i class="fas fa-bolt me-2"></i>Lambda Function
                                        </a></li>
                                        <li><a class="dropdown-item" href="#" onclick="setEditTrustPolicyTemplate('s3')">
                                            <i class="fas fa-cube me-2"></i>S3 Service
                                        </a></li>
                                        <li><a class="dropdown-item" href="#" onclick="setEditTrustPolicyTemplate('ecs')">
                                            <i class="fas fa-docker me-2"></i>ECS Task
                                        </a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item" href="#" onclick="setEditTrustPolicyTemplate('cross-account')">
                                            <i class="fas fa-exchange-alt me-2"></i>Cross Account
                                        </a></li>
                                        <li><a class="dropdown-item" href="#" onclick="setEditTrustPolicyTemplate('web-identity')">
                                            <i class="fas fa-globe me-2"></i>Web Identity
                                        </a></li>
                                    </ul>
                                </div>
                                <button type="button" class="btn btn-sm btn-outline-secondary ms-2" onclick="validateEditTrustPolicy()">
                                    <i class="fas fa-check me-1"></i>Validate
                                </button>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="editAttachedPolicies" class="form-label">Attached Policies</label>
                            <input type="text" class="form-control" id="editAttachedPolicies" name="attached_policies">
                            <div class="form-text">Comma-separated list of policy names to attach</div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-warning" onclick="updateRole()">
                        <i class="fas fa-save me-1"></i>Update Role
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Delete Role Modal -->
    <div class="modal fade" id="deleteRoleModal" tabindex="-1" role="dialog" aria-labelledby="deleteRoleModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteRoleModalLabel">
                        <i class="fas fa-trash me-2"></i>Delete Role
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete the role <strong id="deleteRoleName"></strong>?</p>
                    <p class="text-warning">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        This action cannot be undone. Any applications or services using this role will lose access.
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger" onclick="confirmDeleteRole()">
                        <i class="fas fa-trash me-1"></i>Delete Role
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Global variables
        let currentRoleName = '';

        // Role management functions
        function createRole() {
            const form = document.getElementById('createRoleForm');
            const formData = new FormData(form);
            
            const roleData = {
                name: formData.get('name'),
                role_arn: formData.get('role_arn'),
                description: formData.get('description'),
                trust_policy: {},
                attached_policies: []
            };

            // Parse trust policy JSON
            try {
                roleData.trust_policy = JSON.parse(formData.get('trust_policy'));
            } catch (e) {
                showErrorMessage('Invalid JSON in trust policy: ' + e.message);
                return;
            }

            // Parse attached policies
            const policiesStr = formData.get('attached_policies');
            if (policiesStr.trim()) {
                roleData.attached_policies = policiesStr.split(',').map(p => p.trim()).filter(p => p);
            }

            fetch('/api/object-store/roles', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(roleData)
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    showSuccessMessage('Role created successfully!');
                    location.reload();
                } else {
                    showErrorMessage('Error creating role: ' + data.error);
                }
            })
            .catch(error => {
                showErrorMessage('Error creating role: ' + error.message);
            });
        }

        function viewRole(event) {
            // Try currentTarget first (the button), then target (the icon)
            let button = event.currentTarget || event.target;
            while (button && button.tagName !== 'BUTTON') {
                button = button.parentElement;
            }
            
            const roleName = button.getAttribute('data-roleName');
            currentRoleName = roleName;
            fetch(`/api/object-store/roles/${roleName}`)
                .then(response => response.json())
                .then(role => {
                    var content = "<div class='row'>" +
                        "<div class='col-md-6'>" +
                            "<h6>Basic Information</h6>" +
                            "<table class='table table-sm'>" +
                                "<tr><td><strong>Name:</strong></td><td>" + role.name + "</td></tr>" +
                                "<tr><td><strong>ARN:</strong></td><td><code>" + role.role_arn + "</code></td></tr>" +
                                "<tr><td><strong>Description:</strong></td><td>" + (role.description || '-') + "</td></tr>" +
                                "<tr><td><strong>Created:</strong></td><td>" + new Date(role.created_at).toLocaleString() + "</td></tr>" +
                                "<tr><td><strong>Updated:</strong></td><td>" + new Date(role.updated_at).toLocaleString() + "</td></tr>" +
                            "</table>" +
                        "</div>" +
                        "<div class='col-md-6'>" +
                            "<h6>Attached Policies</h6>";
                    
                    if (role.attached_policies && role.attached_policies.length > 0) {
                        for (var i = 0; i < role.attached_policies.length; i++) {
                            content += "<span class='badge bg-info me-1'>" + role.attached_policies[i] + "</span>";
                        }
                    } else {
                        content += "<span class='text-muted'>No policies attached</span>";
                    }
                    
                    content += "</div></div>" +
                        "<div class='mt-3'>" +
                            "<h6>Trust Policy</h6>" +
                            "<pre class='bg-light p-3 rounded'><code>" + JSON.stringify(role.trust_policy, null, 2) + "</code></pre>" +
                        "</div>";
                    
                    document.getElementById('viewRoleContent').innerHTML = content;
                    new bootstrap.Modal(document.getElementById('viewRoleModal')).show();
                })
                .catch(error => {
                    showErrorMessage('Error loading role: ' + error.message);
                });
        }

        function editRole(event) {
            // Try currentTarget first (the button), then target (the icon)
            let button = event.currentTarget || event.target;
            while (button && button.tagName !== 'BUTTON') {
                button = button.parentElement;
            }
            
            const roleName = button.getAttribute('data-roleName');
            currentRoleName = roleName;
            fetch(`/api/object-store/roles/${roleName}`)
                .then(response => response.json())
                .then(role => {
                    document.getElementById('editRoleName').value = role.name;
                    document.getElementById('editRoleArn').value = role.role_arn;
                    document.getElementById('editRoleDescription').value = role.description || '';
                    document.getElementById('editTrustPolicy').value = JSON.stringify(role.trust_policy, null, 2);
                    document.getElementById('editAttachedPolicies').value = (role.attached_policies || []).join(', ');
                    new bootstrap.Modal(document.getElementById('editRoleModal')).show();
                })
                .catch(error => {
                    showErrorMessage('Error loading role: ' + error.message);
                });
        }

        function editRoleFromView() {
            bootstrap.Modal.getInstance(document.getElementById('viewRoleModal')).hide();
            editRole(currentRoleName);
        }

        function updateRole() {
            const form = document.getElementById('editRoleForm');
            const formData = new FormData(form);
            
            const roleData = {
                description: formData.get('description'),
                trust_policy: {},
                attached_policies: []
            };

            // Parse trust policy JSON
            try {
                roleData.trust_policy = JSON.parse(formData.get('trust_policy'));
            } catch (e) {
                showErrorMessage('Invalid JSON in trust policy: ' + e.message);
                return;
            }

            // Parse attached policies
            const policiesStr = formData.get('attached_policies');
            if (policiesStr.trim()) {
                roleData.attached_policies = policiesStr.split(',').map(p => p.trim()).filter(p => p);
            }

            fetch(`/api/object-store/roles/${currentRoleName}`, {
                method: 'PUT',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(roleData)
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    showSuccessMessage('Role updated successfully!');
                    location.reload();
                } else {
                    showErrorMessage('Error updating role: ' + data.error);
                }
            })
            .catch(error => {
                showErrorMessage('Error updating role: ' + error.message);
            });
        }

        function deleteRole(event) {
            // Try currentTarget first (the button), then target (the icon)
            let button = event.currentTarget || event.target;
            while (button && button.tagName !== 'BUTTON') {
                button = button.parentElement;
            }
            
            const roleName = button.getAttribute('data-roleName');
            currentRoleName = roleName;
            document.getElementById('deleteRoleName').textContent = roleName;
            new bootstrap.Modal(document.getElementById('deleteRoleModal')).show();
        }

        function confirmDeleteRole() {
            fetch(`/api/object-store/roles/${currentRoleName}`, {
                method: 'DELETE'
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    showSuccessMessage('Role deleted successfully!');
                    location.reload();
                } else {
                    showErrorMessage('Error deleting role: ' + data.error);
                }
            })
            .catch(error => {
                showErrorMessage('Error deleting role: ' + error.message);
            });
        }

        // Trust policy template functions
        function setTrustPolicyTemplate(type) {
            var templates = {
                'ec2': {
                    "Version": "2012-10-17",
                    "Statement": [
                        {
                            "Effect": "Allow",
                            "Principal": {
                                "Service": "ec2.amazonaws.com"
                            },
                            "Action": ["sts:AssumeRole"]
                        }
                    ]
                },
                'lambda': {
                    "Version": "2012-10-17",
                    "Statement": [
                        {
                            "Effect": "Allow",
                            "Principal": {
                                "Service": "lambda.amazonaws.com"
                            },
                            "Action": ["sts:AssumeRole"]
                        }
                    ]
                },
                's3': {
                    "Version": "2012-10-17",
                    "Statement": [
                        {
                            "Effect": "Allow",
                            "Principal": {
                                "Service": "s3.amazonaws.com"
                            },
                            "Action": ["sts:AssumeRole"]
                        }
                    ]
                },
                'ecs': {
                    "Version": "2012-10-17",
                    "Statement": [
                        {
                            "Effect": "Allow",
                            "Principal": {
                                "Service": "ecs-tasks.amazonaws.com"
                            },
                            "Action": ["sts:AssumeRole"]
                        }
                    ]
                },
                'cross-account': {
                    "Version": "2012-10-17",
                    "Statement": [
                        {
                            "Effect": "Allow",
                            "Principal": {
                                "AWS": "arn:aws:iam::ACCOUNT-ID:root"
                            },
                            "Action": ["sts:AssumeRole"],
                            "Condition": {}
                        }
                    ]
                },
                'web-identity': {
                    "Version": "2012-10-17",
                    "Statement": [
                        {
                            "Effect": "Allow",
                            "Principal": {
                                "Federated": "arn:aws:iam::ACCOUNT-ID:oidc-provider/oidc.eks.REGION.amazonaws.com/id/CLUSTER-ID"
                            },
                            "Action": ["sts:AssumeRoleWithWebIdentity"],
                            "Condition": {}
                        }
                    ]
                }
            };
            
            var policy = templates[type];
            if (policy) {
                document.getElementById('trustPolicy').value = JSON.stringify(policy, null, 2);
                showSuccessMessage('Trust policy template applied!');
            }
        }

        function setEditTrustPolicyTemplate(type) {
            var templates = {
                'ec2': {
                    "Version": "2012-10-17",
                    "Statement": [
                        {
                            "Effect": "Allow",
                            "Principal": {
                                "Service": "ec2.amazonaws.com"
                            },
                            "Action": ["sts:AssumeRole"]
                        }
                    ]
                },
                'lambda': {
                    "Version": "2012-10-17",
                    "Statement": [
                        {
                            "Effect": "Allow",
                            "Principal": {
                                "Service": "lambda.amazonaws.com"
                            },
                            "Action": ["sts:AssumeRole"]
                        }
                    ]
                },
                's3': {
                    "Version": "2012-10-17",
                    "Statement": [
                        {
                            "Effect": "Allow",
                            "Principal": {
                                "Service": "s3.amazonaws.com"
                            },
                            "Action": ["sts:AssumeRole"]
                        }
                    ]
                },
                'ecs': {
                    "Version": "2012-10-17",
                    "Statement": [
                        {
                            "Effect": "Allow",
                            "Principal": {
                                "Service": "ecs-tasks.amazonaws.com"
                            },
                            "Action": ["sts:AssumeRole"]
                        }
                    ]
                },
                'cross-account': {
                    "Version": "2012-10-17",
                    "Statement": [
                        {
                            "Effect": "Allow",
                            "Principal": {
                                "AWS": "arn:aws:iam::ACCOUNT-ID:root"
                            },
                            "Action": ["sts:AssumeRole"],
                            "Condition": {}
                        }
                    ]
                },
                'web-identity': {
                    "Version": "2012-10-17",
                    "Statement": [
                        {
                            "Effect": "Allow",
                            "Principal": {
                                "Federated": "arn:aws:iam::ACCOUNT-ID:oidc-provider/oidc.eks.REGION.amazonaws.com/id/CLUSTER-ID"
                            },
                            "Action": ["sts:AssumeRoleWithWebIdentity"],
                            "Condition": {}
                        }
                    ]
                }
            };
            
            var policy = templates[type];
            if (policy) {
                document.getElementById('editTrustPolicy').value = JSON.stringify(policy, null, 2);
                showSuccessMessage('Trust policy template applied!');
            }
        }

        function validateTrustPolicy() {
            const policyText = document.getElementById('trustPolicy').value;
            try {
                const policy = JSON.parse(policyText);
                fetch('/api/object-store/roles/validate', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ trust_policy: policy })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.valid) {
                        showSuccessMessage('Trust policy is valid!');
                    } else {
                        showErrorMessage('Trust policy validation failed: ' + data.error);
                    }
                })
                .catch(error => {
                    showErrorMessage('Error validating policy: ' + error.message);
                });
            } catch (e) {
                showErrorMessage('Invalid JSON: ' + e.message);
            }
        }

        function validateEditTrustPolicy() {
            const policyText = document.getElementById('editTrustPolicy').value;
            try {
                const policy = JSON.parse(policyText);
                fetch('/api/object-store/roles/validate', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ trust_policy: policy })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.valid) {
                        showSuccessMessage('Trust policy is valid!');
                    } else {
                        showErrorMessage('Trust policy validation failed: ' + data.error);
                    }
                })
                .catch(error => {
                    showErrorMessage('Error validating policy: ' + error.message);
                });
            } catch (e) {
                showErrorMessage('Invalid JSON: ' + e.message);
            }
        }

        // Initialize DataTable if available
        document.addEventListener('DOMContentLoaded', function() {
            if (typeof $ !== 'undefined' && $.fn.DataTable) {
                $('#rolesTable').DataTable({
                    responsive: true,
                    pageLength: 25,
                    order: [[0, 'asc']]
                });
            }
        });
    </script>
}
