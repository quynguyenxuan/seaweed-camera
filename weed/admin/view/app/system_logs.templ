package app

import (
	"fmt"
	"time"

	"github.com/seaweedfs/seaweedfs/weed/admin/dash"
)

templ SystemLogs(logFiles []dash.LogFileInfo) {
	<div class="container-fluid">
		<div class="row">
			<div class="col-12">
				<div class="d-flex justify-content-between align-items-center mb-4">
					<div>
						<h4 class="mb-1">
							<i class="fas fa-file-alt me-2"></i>
							System Logs
						</h4>
						<p class="text-muted mb-0">View and search system log files</p>
					</div>
					<div class="btn-group">
						<button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#searchModal">
							<i class="fas fa-search me-1"></i>
							Search Logs
						</button>
						<button type="button" class="btn btn-outline-secondary" onclick="refreshLogs()">
							<i class="fas fa-sync-alt me-1"></i>
							Refresh
						</button>
					</div>
				</div>

				// Log Files Grid
				<div class="row" id="logFilesContainer">
					if len(logFiles) == 0 {
						<div class="col-12">
							<div class="text-center py-5">
								<i class="fas fa-file-alt fa-3x text-muted mb-3"></i>
								<h5 class="text-muted">No Log Files Found</h5>
								<p class="text-muted">Check log directory configuration and ensure logs are being generated.</p>
							</div>
						</div>
					} else {
						for _, logFile := range logFiles {
							<div class="col-lg-4 col-md-6 mb-3">
								<div class="card h-100 log-file-card" data-file={logFile.Name}>
									<div class="card-header d-flex justify-content-between align-items-center">
										<div class="d-flex align-items-center">
											<i class="fas fa-file-alt me-2"></i>
											<span class="fw-bold">{logFile.Name}</span>
										</div>
										<span class="badge bg-{getLogLevelColorSystem(logFile.Level)}">{logFile.Level}</span>
									</div>
									<div class="card-body">
										<div class="row text-sm">
											<div class="col-6">
												<div class="text-muted">Size</div>
												<div class="fw-semibold">{formatFileSize(logFile.Size)}</div>
											</div>
											<div class="col-6">
												<div class="text-muted">Modified</div>
												<div class="fw-semibold">{formatTime(logFile.ModifiedTime)}</div>
											</div>
										</div>
									</div>
									<div class="card-footer">
										<div class="btn-group w-100" role="group">
											<button type="button" class="btn btn-outline-primary btn-sm view-log-btn" 
												data-file={logFile.Name} data-level={logFile.Level}>
												<i class="fas fa-eye me-1"></i>
												View
											</button>
											<button type="button" class="btn btn-outline-info btn-sm download-log-btn" 
												data-file={logFile.Name}>
												<i class="fas fa-download me-1"></i>
												Download
											</button>
										</div>
									</div>
								</div>
							</div>
						}
					}
				</div>
			</div>
		</div>
	</div>

	// Search Modal
	<div class="modal fade" id="searchModal" tabindex="-1">
		<div class="modal-dialog modal-lg">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title">
						<i class="fas fa-search me-2"></i>
						Search Logs
					</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
				</div>
				<div class="modal-body">
					<form id="searchForm">
						<div class="row">
							<div class="col-md-6 mb-3">
								<label for="searchQuery" class="form-label">Search Query</label>
								<input type="text" class="form-control" id="searchQuery" 
									placeholder="Enter search text..." required>
							</div>
							<div class="col-md-3 mb-3">
								<label for="logLevel" class="form-label">Log Level</label>
								<select class="form-select" id="logLevel">
									<option value="">All Levels</option>
									<option value="INFO">INFO</option>
									<option value="WARNING">WARNING</option>
									<option value="ERROR">ERROR</option>
								</select>
							</div>
							<div class="col-md-3 mb-3">
								<label for="maxResults" class="form-label">Max Results</label>
								<input type="number" class="form-control" id="maxResults" 
									value="50" min="1" max="1000">
							</div>
						</div>
						<div class="d-grid">
							<button type="submit" class="btn btn-primary">
								<i class="fas fa-search me-1"></i>
								Search
							</button>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>

	// Log Viewer Modal
	<div class="modal fade" id="logViewerModal" tabindex="-1">
		<div class="modal-dialog modal-xl">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title">
						<i class="fas fa-file-alt me-2"></i>
						<span id="logViewerTitle">Log Viewer</span>
					</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
				</div>
				<div class="modal-body">
					<div class="d-flex justify-content-between align-items-center mb-3">
						<div class="btn-group">
							<button type="button" class="btn btn-outline-secondary btn-sm" id="loadMoreBtn">
								<i class="fas fa-plus me-1"></i>
								Load More
							</button>
							<button type="button" class="btn btn-outline-secondary btn-sm" id="autoScrollBtn">
								<i class="fas fa-arrows-alt-v me-1"></i>
								Auto Scroll
							</button>
						</div>
						<div class="form-check form-switch">
							<input class="form-check-input" type="checkbox" id="followTailCheckbox">
							<label class="form-check-label" for="followTailCheckbox">
								Follow Tail
							</label>
						</div>
					</div>
					<div class="log-viewer-container">
						<pre id="logContent" class="log-content"></pre>
					</div>
				</div>
			</div>
		</div>
	</div>

	// Search Results Modal
	<div class="modal fade" id="searchResultsModal" tabindex="-1">
		<div class="modal-dialog modal-xl">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title">
						<i class="fas fa-search me-2"></i>
						Search Results
					</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
				</div>
				<div class="modal-body">
					<div id="searchResultsContainer"></div>
				</div>
			</div>
		</div>
	</div>

	<script type="text/javascript">
		let currentLogFile = null;
		let autoScrollEnabled = false;
		let followTailEnabled = false;
		let logViewerInterval = null;

		// Initialize
		document.addEventListener('DOMContentLoaded', function() {
			setupEventListeners();
		});

		function setupEventListeners() {
			// View log buttons
			document.querySelectorAll('.view-log-btn').forEach(button => {
				button.addEventListener('click', function() {
					const fileName = this.getAttribute('data-file');
					const level = this.getAttribute('data-level');
					openLogViewer(fileName, level);
				});
			});

			// Download log buttons
			document.querySelectorAll('.download-log-btn').forEach(button => {
				button.addEventListener('click', function() {
					const fileName = this.getAttribute('data-file');
					downloadLogFile(fileName);
				});
			});

			// Search form
			document.getElementById('searchForm').addEventListener('submit', function(e) {
				e.preventDefault();
				searchLogs();
			});

			// Load more button
			document.getElementById('loadMoreBtn').addEventListener('click', loadMoreLogs);

			// Auto scroll button
			document.getElementById('autoScrollBtn').addEventListener('click', toggleAutoScroll);

			// Follow tail checkbox
			document.getElementById('followTailCheckbox').addEventListener('change', function() {
				followTailEnabled = this.checked;
				if (followTailEnabled) {
					startLogTail();
				} else {
					stopLogTail();
				}
			});

			// Log viewer modal close event
			document.getElementById('logViewerModal').addEventListener('hidden.bs.modal', function() {
				stopLogTail();
			});
		}

		function openLogViewer(fileName, level) {
			currentLogFile = fileName;
			document.getElementById('logViewerTitle').textContent = `Log Viewer: ${fileName}`;
			
			// Set badge color based on level
			const modalTitle = document.getElementById('logViewerTitle');
			const levelBadge = `<span class="badge bg-${getLogLevelColor(level)} ms-2">${level}</span>`;
			modalTitle.innerHTML = `Log Viewer: ${fileName} ${levelBadge}`;
			
			// Load initial log content
			loadLogContent(fileName, 100);
			
			// Show modal
			const modal = new bootstrap.Modal(document.getElementById('logViewerModal'));
			modal.show();
		}

		function loadLogContent(fileName, lines) {
			const logContent = document.getElementById('logContent');
			logContent.innerHTML = '<div class="text-center"><i class="fas fa-spinner fa-spin"></i> Loading...</div>';

			fetch(`/api/logs/file?file=${encodeURIComponent(fileName)}&lines=${lines}`)
				.then(response => response.json())
				.then(data => {
					if (data.error) {
						logContent.innerHTML = `<div class="alert alert-danger">${data.error}</div>`;
						return;
					}

					const content = data.content || [];
					if (content.length === 0) {
						logContent.innerHTML = '<div class="text-muted">No log content available</div>';
						return;
					}

					// Format and display log content
					const formattedContent = content.map(line => formatLogLine(line)).join('\n');
					logContent.textContent = formattedContent;

					// Auto scroll to bottom if enabled
					if (autoScrollEnabled) {
						logContent.scrollTop = logContent.scrollHeight;
					}
				})
				.catch(error => {
					logContent.innerHTML = `<div class="alert alert-danger">Error loading log: ${error.message}</div>`;
				});
		}

		function loadMoreLogs() {
			if (!currentLogFile) return;
			
			const currentLines = document.getElementById('logContent').textContent.split('\n').length;
			const newLines = currentLines + 100;
			
			loadLogContent(currentLogFile, newLines);
		}

		function toggleAutoScroll() {
			autoScrollEnabled = !autoScrollEnabled;
			const btn = document.getElementById('autoScrollBtn');
			
			if (autoScrollEnabled) {
				btn.classList.remove('btn-outline-secondary');
				btn.classList.add('btn-primary');
				btn.innerHTML = '<i class="fas fa-arrows-alt-v me-1"></i>Auto Scroll ON';
			} else {
				btn.classList.remove('btn-primary');
				btn.classList.add('btn-outline-secondary');
				btn.innerHTML = '<i class="fas fa-arrows-alt-v me-1"></i>Auto Scroll';
			}
		}

		function startLogTail() {
			if (!currentLogFile || !followTailEnabled) return;
			
			logViewerInterval = setInterval(() => {
				loadLogContent(currentLogFile, 50); // Load last 50 lines for tail
			}, 2000); // Update every 2 seconds
		}

		function stopLogTail() {
			if (logViewerInterval) {
				clearInterval(logViewerInterval);
				logViewerInterval = null;
			}
		}

		function searchLogs() {
			const query = document.getElementById('searchQuery').value;
			const level = document.getElementById('logLevel').value;
			const maxResults = document.getElementById('maxResults').value;

			if (!query.trim()) {
				showMessage('Please enter a search query', 'warning');
				return;
			}

			// Close search modal and show loading
			bootstrap.Modal.getInstance(document.getElementById('searchModal')).hide();
			
			const resultsContainer = document.getElementById('searchResultsContainer');
			resultsContainer.innerHTML = '<div class="text-center"><i class="fas fa-spinner fa-spin"></i> Searching...</div>';

			// Show results modal
			const resultsModal = new bootstrap.Modal(document.getElementById('searchResultsModal'));
			resultsModal.show();

			// Perform search
			let searchUrl = `/api/logs/search?query=${encodeURIComponent(query)}&max=${maxResults}`;
			if (level) {
				searchUrl += `&level=${level}`;
			}

			fetch(searchUrl)
				.then(response => response.json())
				.then(data => {
					displaySearchResults(data);
				})
				.catch(error => {
					resultsContainer.innerHTML = `<div class="alert alert-danger">Search error: ${error.message}</div>`;
				});
		}

		function displaySearchResults(data) {
			const resultsContainer = document.getElementById('searchResultsContainer');
			
			if (!data.entries || data.entries.length === 0) {
				resultsContainer.innerHTML = `
					<div class="text-center py-4">
						<i class="fas fa-search fa-2x text-muted mb-3"></i>
						<h5 class="text-muted">No Results Found</h5>
						<p class="text-muted">No log entries found matching your search criteria.</p>
					</div>
				`;
				return;
			}

			let html = `
				<div class="alert alert-info">
					Found <strong>${data.total}</strong> results for query: <code>${data.query}</code>
				</div>
				<div class="log-search-results">
			`;

			data.entries.forEach(entry => {
				html += `
					<div class="log-entry card mb-2">
						<div class="card-header py-2 d-flex justify-content-between align-items-center">
							<div class="d-flex align-items-center">
								<span class="badge bg-${getLogLevelColor(entry.level)} me-2">${entry.level}</span>
								<small class="text-muted">${formatTimestamp(entry.timestamp)}</small>
							</div>
							<small class="text-muted">${entry.file}:${entry.line}</small>
						</div>
						<div class="card-body py-2">
							<code class="log-message">${escapeHtml(entry.message)}</code>
						</div>
					</div>
				`;
			});

			html += '</div>';
			resultsContainer.innerHTML = html;
		}

		function downloadLogFile(fileName) {
			const link = document.createElement('a');
			link.href = `/api/logs/file?file=${encodeURIComponent(fileName)}&lines=10000`;
			link.download = fileName;
			document.body.appendChild(link);
			link.click();
			document.body.removeChild(link);
		}

		function refreshLogs() {
			window.location.reload();
		}

		// Helper functions
		function formatLogLine(line) {
			// Add color coding for log levels
			if (line.startsWith('I')) {
				return line; // INFO - default color
			} else if (line.startsWith('W')) {
				return line; // WARNING - could add yellow styling
			} else if (line.startsWith('E')) {
				return line; // ERROR - could add red styling
			}
			return line;
		}

		function getLogLevelColor(level) {
			switch (level) {
				case 'INFO': return 'primary';
				case 'WARNING': return 'warning';
				case 'ERROR': return 'danger';
				default: return 'secondary';
			}
		}

		function formatTimestamp(timestamp) {
			return new Date(timestamp).toLocaleString();
		}

		function escapeHtml(text) {
			const div = document.createElement('div');
			div.textContent = text;
			return div.innerHTML;
		}

		function showMessage(message, type) {
			// Implement toast or alert notification
			alert(message);
		}
	</script>

	<style>
		.log-viewer-container {
			max-height: 600px;
			overflow-y: auto;
		}

		.log-content {
			background-color: #f8f9fa;
			border: 1px solid #dee2e6;
			border-radius: 0.375rem;
			padding: 1rem;
			font-family: 'Courier New', monospace;
			font-size: 0.875rem;
			line-height: 1.4;
			white-space: pre-wrap;
			word-wrap: break-word;
			max-height: 500px;
			overflow-y: auto;
		}

		.log-file-card {
			transition: transform 0.2s, box-shadow 0.2s;
		}

		.log-file-card:hover {
			transform: translateY(-2px);
			box-shadow: 0 4px 8px rgba(0,0,0,0.1);
		}

		.log-entry .card-header {
			background-color: #f8f9fa;
			border-bottom: 1px solid #dee2e6;
		}

		.log-message {
			font-size: 0.875rem;
			word-wrap: break-word;
		}

		.log-search-results {
			max-height: 500px;
			overflow-y: auto;
		}
	</style>
}

// Helper functions for templating
func formatFileSize(size int64) string {
	const unit = 1024
	if size < unit {
		return fmt.Sprintf("%d B", size)
	}
	div, exp := int64(unit), 0
	for n := size / unit; n >= unit; n /= unit {
		div *= unit
		exp++
	}
	return fmt.Sprintf("%.1f %cB", float64(size)/float64(div), "KMGTPE"[exp])
}

func formatTime(t time.Time) string {
	if t.IsZero() {
		return "Unknown"
	}
	return t.Format("2006-01-02 15:04:05")
}

func getLogLevelColorSystem(level string) string {
	switch level {
	case "INFO":
		return "primary"
	case "WARNING":
		return "warning"
	case "ERROR":
		return "danger"
	default:
		return "secondary"
	}
}
