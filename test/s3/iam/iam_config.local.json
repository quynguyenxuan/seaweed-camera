{
  "sts": {
    "tokenDuration": "1h",
    "maxSessionLength": "12h",
    "issuer": "sunfs-sts",
    "signingKey": "dGVzdC1zaWduaW5nLWtleS0zMi1jaGFyYWN0ZXJzLWxvbmc="
  },
  "providers": [
    {
      "name": "keycloak",
      "type": "oidc",
      "enabled": true,
      "config": {
        "issuer": "http://localhost:8089/realms/sunfs",
        "clientId": "sunfs-s3",
        "clientSecret": "3vezVrpOTvR3kLOoYu5J0j10SBj8wyGW",
        "jwksUri": "http://localhost:8089/realms/sunfs/protocol/openid-connect/certs",
        "userInfoUri": "http://localhost:8089/realms/sunfs/protocol/openid-connect/userinfo",
        "scopes": [
          "openid",
          "profile",
          "email"
        ],
        "claimsMapping": {
          "username": "preferred_username",
          "email": "email",
          "name": "name"
        },
        "roleMapping": {
          "rules": [
            {
              "claim": "roles",
              "value": "s3-admin",
              "role": "arn:aws:iam::role/KeycloakAdminRole"
            },
            {
              "claim": "roles",
              "value": "s3-read-only",
              "role": "arn:aws:iam::role/KeycloakReadOnlyRole"
            },
            {
              "claim": "roles",
              "value": "s3-write-only",
              "role": "arn:aws:iam::role/KeycloakWriteOnlyRole"
            },
            {
              "claim": "roles",
              "value": "s3-read-write",
              "role": "arn:aws:iam::role/KeycloakReadWriteRole"
            }
          ],
          "defaultRole": "arn:aws:iam::role/KeycloakReadOnlyRole"
        }
      }
    }
  ],
  "policy": {
    "defaultEffect": "Allow",
    "storeType": "bunsql",
    "storeConfig": {
      "driver": "postgresql",
      "hostname": "100.70.143.104",
      "port": 5432,
      "username": "sunfs",
      "password": "sunfs",
      "database": "sunfs_iam",
      "schema": "public",
      "sslmode": "disable",
      "table_name": "sts_policies",
      "timeout": "30s",
      "ttl": "5s",
      "listTtl": "5s"
    }
  },
  "roleStore": {
    "storeType": "bunsql",
    "storeConfig": {
      "driver": "postgresql",
      "hostname": "100.70.143.104",
      "port": 5432,
      "username": "sunfs",
      "password": "sunfs",
      "database": "sunfs_iam",
      "schema": "public",
      "sslmode": "disable",
      "table_name": "iam_roles",
      "timeout": "30s",
      "ttl": "5s",
      "listTtl": "5s"

    }
  },
  "policyStoreCassandra": {
    "defaultEffect": "Allow",
    "storeType": "cassandra",
    "storeConfig": {
      "hosts": ["localhost"],
      "port": 9042,
      "keyspace": "sunfs",
      "table_name": "policies",
      "timeout": "5s",
      "connect_timeout": "10s",
      "consistency": "LocalQuorum"
    }
  },
  "roleStoreCassandra": {
    "storeType": "cassandra",
    "storeConfig": {
      "hosts": ["localhost"],
      "port": 9042,
      "keyspace": "sunfs",
      "table_name": "roles",
      "timeout": "5s",
      "connect_timeout": "10s",
      "consistency": "LocalQuorum"
    }
  },
  "roles": [
    {
      "roleName": "Admin",
      "roleArn": "arn:aws:iam::role/Admin",
      "trustPolicy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Principal": {
              "Federated": "test-oidc"
            },
            "Action": [
              "sts:AssumeRoleWithWebIdentity",
              "sts:AssumeRole"
            ]
          }
        ]
      },
      "attachedPolicies": [
        "S3AdminPolicy"
      ],
      "description": "Admin role for testing"
    },
    {
      "roleName": "ReadOnly",
      "roleArn": "arn:aws:iam::role/ReadOnly",
      "trustPolicy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Principal": {
              "Federated": "test-oidc"
            },
            "Action": [
              "sts:AssumeRoleWithWebIdentity",
              "sts:AssumeRole"
            ]
          }
        ]
      },
      "attachedPolicies": [
        "S3ReadOnlyPolicy"
      ],
      "description": "Read-only role for testing"
    },
    
    {
      "roleName": "WriteOnly",
      "roleArn": "arn:aws:iam::role/WriteOnly",
      "trustPolicy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Principal": {
              "Federated": "keycloak"
            },
            "Action": [
              "sts:AssumeRoleWithWebIdentity",
              "sts:AssumeRole"
            ]
          }
        ]
      },
      "attachedPolicies": [
        "S3WriteOnlyPolicy"
      ],
      "description": "Write-only role for Keycloak users"
    },
    {
      "roleName": "ReadWrite",
      "roleArn": "arn:aws:iam::role/ReadWrite",
      "trustPolicy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Principal": {
              "Federated": "keycloak"
            },
            "Action": [
              "sts:AssumeRoleWithWebIdentity",
              "sts:AssumeRole"
            ]
          }
        ]
      },
      "attachedPolicies": [
        "S3ReadWritePolicy"
      ],
      "description": "Read-write role for Keycloak users"
    }
  ],
  "policies": [
    {
      "name": "S3AdminPolicy",
      "document": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Action": [
              "s3:*"
            ],
            "Resource": [
              "*"
            ]
          },
          {
            "Effect": "Allow",
            "Action": [
              "sts:ValidateSession"
            ],
            "Resource": [
              "*"
            ]
          }
        ]
      }
    },
    {
      "name": "S3ReadOnlyPolicy",
      "document": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Action": [
              "s3:GetObject",
              "s3:ListBucket"
            ],
            "Resource": [
              "arn:aws:s3:::*",
              "arn:aws:s3:::*/*"
            ]
          },
          {
            "Effect": "Allow",
            "Action": [
              "sts:ValidateSession"
            ],
            "Resource": [
              "*"
            ]
          }
        ]
      }
    },
    {
      "name": "S3WriteOnlyPolicy",
      "document": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Action": [
              "s3:*"
            ],
            "Resource": [
              "arn:aws:s3:::*",
              "arn:aws:s3:::*/*"
            ]
          },
          {
            "Effect": "Deny",
            "Action": [
              "s3:GetObject",
              "s3:ListBucket"
            ],
            "Resource": [
              "arn:aws:s3:::*",
              "arn:aws:s3:::*/*"
            ]
          },
          {
            "Effect": "Allow",
            "Action": [
              "sts:ValidateSession"
            ],
            "Resource": [
              "*"
            ]
          }
        ]
      }
    },
    {
      "name": "S3ReadWritePolicy",
      "document": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Action": [
              "s3:*"
            ],
            "Resource": [
              "arn:aws:s3:::*",
              "arn:aws:s3:::*/*"
            ]
          },
          {
            "Effect": "Allow",
            "Action": [
              "sts:ValidateSession"
            ],
            "Resource": [
              "*"
            ]
          }
        ]
      }
    }
  ]
}
